# Copy to .env.local for local dev, and set the same names as Environment
# Variables in the Vercel project settings for production.

# Public — safe to expose in the browser bundle (not secrets).
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Server-only — used by /api/preview.ts (a Vercel serverless function).
# Do NOT prefix this with VITE_ — that would bundle it into the public
# browser JS. Create this as a "Viewer" token in sanity.io/manage so a
# leak only exposes draft content, never write access.
SANITY_PREVIEW_TOKEN=

# Local-only — used once by `npm run migrate:sanity` (scripts/migrateToSanity.mjs)
# to seed the starting content. Create this as an "Editor" (write) token in
# sanity.io/manage. Never put this in Vercel or commit it — delete the token
# from sanity.io/manage once the migration has run.
SANITY_WRITE_TOKEN=
